# Which backend answers: gemini or openai.
AI_PROVIDER=gemini

# Optional. A Home Assistant input_select read at the start of every session,
# letting you switch backends from a dashboard without restarting the add-on.
# Its options may say "Gemini" / "ChatGPT" / "OpenAI" — matching is fuzzy.
# Leave empty to always use AI_PROVIDER.
AI_PROVIDER_ENTITY=

GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Aoede

# Used when AI_PROVIDER=openai. Web search still goes through Gemini, so keep
# GEMINI_API_KEY set even when OpenAI answers the audio.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-realtime-2.1-mini
OPENAI_VOICE=marin

# Standalone mode only. The Home Assistant add-on sets these automatically.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_home_assistant_long_lived_access_token
HA_ENTITY_REGISTRY_PATH=/path/to/core.entity_registry

# Optional. JSON object mapping entity_id prefixes to room names.
ROOM_ALIASES_JSON={"living_room":"living room","bedroom":"bedroom"}

# Optional. Enables the control_vacuum tool when set.
VACUUM_ENTITY_ID=

ASSISTANT_LANGUAGE=en-US
ASSISTANT_RESPONSE_LANGUAGE=English

# Local dev: plugins are not kept in this repo (see plugin_packages/README.md).
# Point this at wherever you keep them locally.
PLUGINS_DIR=../assistant_plugins
# Shared secret for POST /plugins/<id>/secret/<name>; empty disables the endpoint
PLUGIN_API_TOKEN=
